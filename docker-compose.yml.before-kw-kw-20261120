services:
  mysql:
    image: mysql:8.0
    container_name: kingway-mysql
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "5"
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: ${MYSQL_DATABASE}
      MYSQL_USER: ${MYSQL_USER}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
      TZ: Asia/Taipei
    ports:
      - "3306:3306"
    volumes:
      - mysql_data:/var/lib/mysql
      - ./database/schema.sql:/docker-entrypoint-initdb.d/schema.sql:ro
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --innodb-buffer-pool-size=256M
      - --innodb-buffer-pool-instances=1
      - --performance-schema=OFF

  backend:
    image: node:20-alpine
    container_name: kingway-backend
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "5"
    working_dir: /app
    depends_on:
      - mysql
    env_file:
      - .env
    environment:
      TZ: Asia/Taipei
    ports:
      - "3000:3000"
    volumes:
      - /volume1/docker/kingway-store-releases/staff-scheduling-production-20260812_223224/backend:/app
      - /volume1/docker/kingway-store/backend/storage:/app/storage
      - /volume1/docker/kingway-store/backend/uploads:/app/uploads
      - /volume1/docker/kingway-store/shared:/shared:ro
    command: sh -c "npm install && npm start"

  frontend:
    build:
      context: /volume1/docker/kingway-store-releases/staff-scheduling-workday-title-20260813_053913/frontend
      dockerfile: Dockerfile
    container_name: kingway-frontend
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "5"
    depends_on:
      - backend
    ports:
      - "5173:80"

volumes:
  mysql_data:
